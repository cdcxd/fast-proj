{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["es2022", "esnext.disposable", "dom"]
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/bench", "packages/*/scripts"]
}
