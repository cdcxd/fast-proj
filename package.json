{
  "name": "fast-utm",
  "version": "0.0.0",
  "description": "Fast UTM <-> WGS84 conversion with batch typed-array APIs",
  "keywords": [
    "geodesy",
    "projection",
    "transverse mercator",
    "utm",
    "wgs84"
  ],
  "homepage": "https://github.com/cdcxd/fast-utm#readme",
  "bugs": "https://github.com/cdcxd/fast-utm/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdcxd/fast-utm.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "bun run build && node bench/run.mjs && bun bench/run.mjs && node bench/run.mjs --browser",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/proj4": "^2.19.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "proj4": "^2.22.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
